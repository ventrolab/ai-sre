  "cards": [
    {
      "dot": "emerald",
      "title": "HolmesGPT as investigator",
      "items": [
        "Only alerts labeled ai_sre=\"investigate\" are routed to AI SRE; the rest stay on direct receivers",
        "SRE Controller calls the Holmes HTTP API with the alert context",
        "Holmes reaches every target through Tool Hub MCP servers (read tools only)",
        "Holmes returns RCA plus a structured remediation proposal",
        "Controller owns incident state, dedup and the remediation playbooks"
      ]
    },
    {
      "dot": "rose",
      "title": "Remediation mode (SRE_MODE)",
      "items": [
        "readonly: actions only proposed in chat, never executed",
        "autofix: low-risk playbooks run automatically; high-risk ones wait for chat approval",
        "Every action: dry-run, verify, automatic rollback on failure",
        "Rate limit and circuit breaker per target; full audit trail"
      ]
    },
    {
      "dot": "amber",
      "title": "Web console",
      "items": [
        "Dashboard: incidents, time to diagnosis, remediation mode, component health",
        "Incidents, approvals, questions to HolmesGPT, playbooks, knowledge base",
        "Local accounts and OIDC (Keycloak); SSO-only mode; roles viewer, operator, admin",
        "Actions go through ingest, like chat commands"
      ]
    },
    {
      "dot": "cyan",
      "title": "Chat Gateway plugins",
      "items": [
        "One internal message model: notify, ask, approve, reject",
        "Adapters (Slack, Telegram, others) enabled via CHAT_ADAPTERS",
        "Interactive buttons map to approval events in the queue"
      ]
    },
    {
      "dot": "violet",
      "title": "LLM and reach",
      "items": [
        "LLM_PROVIDER picks claude / openai / ollama behind LiteLLM",
        "Agents dial out over WSS with an agent token (mTLS optional); TLS ends at an ingress, no inbound ports",
        "Logs: Loki, VictoriaLogs, Elasticsearch/OpenSearch behind one logs.query interface",
        "Per-target RBAC; read and write tools are separate MCP permissions"
      ]
    }
  ]
}